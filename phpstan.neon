includes:
    - vendor/pestphp/pest-plugin-phpstan/extension.neon

parameters:
    level: 10
    paths:
        - tests/Unit/MaddraxikonIdentityHmacPeppersTest.php
        - tests/Unit/UriSupportTest.php
        - app/Support/UriSupport.php
        - app/Support/MaddraxikonIdentityHmacPeppers.php
        - app/Support/ScheduleInventory.php
        - app/Support/CoverRatings/CoverSyncInterval.php
    tmpDir: /tmp/omxfc-phpstan
