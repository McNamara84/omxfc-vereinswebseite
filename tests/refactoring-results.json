      {
        "file": "tests/e2e/char-editor.spec.js",
        "scenario": "Attribute help via focus and hover",
        "change": "Reset pointer and keyboard focus before the focus scenario; additionally assert actual focus. All prior ARIA and hover assertions are retained."
      },
      {
        "file": "tests/e2e/dark-mode.spec.js",
        "scenario": "System preference change",
        "change": "Wait for the theme-sync helper before clearing stored preferences and changing the emulated media preference. All theme assertions are retained."
      },
      {
        "file": "tests/e2e/char-editor.spec.js",
        "scenario": "Edit/continue transitions in four expansion cases",
        "change": "Use native strict Playwright mouse actions instead of the shared forced Locator actions at the mode switches. Add visible continue-button assertions. Both initially failing WebKit cases passed twice; all four affected cases passed in all three browsers. Every original assertion and input cycle is retained."
      },
      {
        "file": "tests/e2e/char-editor.spec.js",
        "scenario": "Taratze submitted attribute mirrors",
        "change": "Poll the submitted FormData until the Alpine mirrors match the already asserted inputs; all original payload and rule assertions remain."
      },
      {
        "file": "tests/e2e/dark-mode.spec.js",
        "scenario": "System and storage preference changes",
        "change": "Poll conditions at a fixed interval instead of depending on animation frames. Only these two WebKit cases receive 60s: traces show individual evaluate calls taking about 5s and exhausting the original 30s budget. All preference and theme checks remain."
      },
      {
        "file": "tests/e2e/mitglieder.spec.js",
        "scenario": "Copy one member email address",
        "change": "Use a native strict pointer action and wait for the clipboard stub result instead of sleeping for 500ms. Preserve the clipboard assertions."
      },
      {
        "file": "tests/e2e/rpg-npcs.spec.js",
        "scenario": "Shared login/challenge and JavaScript-disabled preview/create",
        "change": "Scope the login selector to the password form and perform native strict clicks. The WebKit trace proves that the shared Locator helper trial action submits the JavaScript-disabled create form, then its forced click waits for the removed button until timeout. Native actions submit once. All three NPC scenarios are verified in all three browsers, retaining both fixture cycles and all assertions."
      },
      {
        "file": "tests/e2e/rpg-combats.spec.js",
        "scenario": "Polling document identity and overdue preparation",
        "change": "Use one native form-submit click and wait for its POST redirect before continuing. Install the document marker after the completed roll navigation and reopen the overdue fight after the acceptance navigation. The marker, polling, permission, combat and pageerror assertions are unchanged."
      },
      {
        "file": "tests/e2e/veranstaltungs-baxx.spec.js",
        "scenario": "Saved participation reward",
        "change": "Wait for the scoped save-form navigation before reloading and checking the saved amount; reward and locking assertions remain."
      },
      {
        "file": "tests/e2e/website-feedback.spec.js",
        "scenario": "Anonymous feedback accessibility",
        "change": "Wait for the fully initialized checkbox with its accessible name before running the unchanged Axe audit."
      }
    ],
